Options -Indexes
DirectoryIndex index.php
<FilesMatch "^PcSaleInventory(?:-Win7)?\.cmd$">
    ForceType application/octet-stream
    <IfModule mod_headers.c>
        Header set Content-Disposition "attachment"
        Header set Cache-Control "no-store, max-age=0"
    </IfModule>
</FilesMatch>
<FilesMatch "^(?:config|\.)">
    Require all denied
</FilesMatch>
